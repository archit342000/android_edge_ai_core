<?xml version="1.0" encoding="utf-8"?>
<!-- .switch::after: a 20 knob, 4 in from the track edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="@dimen/switch_track_height" android:height="@dimen/switch_track_height">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:left="@dimen/switch_thumb_inset" android:top="@dimen/switch_thumb_inset" android:right="@dimen/switch_thumb_inset" android:bottom="@dimen/switch_thumb_inset">
        <shape android:shape="oval">
            <solid android:color="@color/console_switch_thumb" />
        </shape>
    </item>
</layer-list>
