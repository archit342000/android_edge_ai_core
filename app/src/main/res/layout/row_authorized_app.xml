<?xml version="1.0" encoding="utf-8"?>
<!-- A standard row: the app and what it holds, and a way to revoke its access. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Console.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Console.Strong" />

        <TextView
            android:id="@+id/tv_app_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Console.Small" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_revoke_app"
        style="@style/Widget.Console.Button.Plain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_gap"
        android:text="@string/revoke_access" />
</LinearLayout>
